{
  "name": "virtualdeck",
  "version": "1.5.0",
  "description": "VirtualDeck : un Stream Deck virtuel pour Windows. Une grille de boutons qui s'ouvre au raccourci clavier et pilote OBS, Streamlabs, des sons et des programmes.",
  "author": "Thomas Laspougeas",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-static": "^1.55.0",
    "obs-websocket-js": "^5.0.8"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.virtualdeck.app",
    "productName": "VirtualDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/lucide-static/{font,dist}/**",
      "!**/node_modules/lucide-static/{sprite.svg,icon-nodes.json}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VirtualDeck",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "runAfterFinish": true,
      "artifactName": "VirtualDeck-Setup-${version}.${ext}"
    }
  }
}
